{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Read(**/.env)",
            "Read(**/.env.*)"
        ]
    },
    "model": "opus",
    "effortLevel": "high",
    "showThinkingSummaries": true,
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"Claude Code\" subtitle (item 2 of argv) sound name \"Ping\"' -e 'end run' -- 'Turn complete' \"${PWD##*/}\""
                    }
                ]
            }
        ],
        "StopFailure": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"Claude Code\" subtitle (item 2 of argv) sound name \"Basso\"' -e 'end run' -- 'Turn ended with an error' \"${PWD##*/}\""
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "permission_prompt|idle_prompt|agent_needs_input|agent_completed|elicitation_dialog",
                "hooks": [
                    {
                        "type": "command",
                        "command": "osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"Claude Code\" subtitle (item 2 of argv) sound name \"Ping\"' -e 'end run' -- 'Claude needs your input' \"${PWD##*/}\""
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"Claude Code\" subtitle (item 2 of argv) sound name \"Ping\"' -e 'end run' -- 'Claude has a question' \"${PWD##*/}\""
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "context7@claude-plugins-official": true,
        "github@claude-plugins-official": true,
        "playwright@claude-plugins-official": true,
        "superpowers@claude-plugins-official": false,
        "gitlab@claude-plugins-official": true,
        "claude-md-management@claude-plugins-official": true,
        "claude-code-setup@claude-plugins-official": true,
        "langsmith-tracing@langsmith-claude-code-plugins": true
    },
    "extraKnownMarketplaces": {
        "langsmith-claude-code-plugins": {
            "source": {
                "source": "github",
                "repo": "langchain-ai/langsmith-claude-code-plugins"
            }
        }
    },
    "switchModelsOnFlag": true
}
