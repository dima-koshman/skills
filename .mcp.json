{
    "$schema": "./.opencode/schemas/claude-mcp.schema.json",
    "mcpServers": {
        "langfuse-docs": {
            "type": "streamable-http",
            "url": "https://langfuse.com/api/mcp"
        },
        "logfire": {
            "type": "http",
            "url": "https://logfire-eu.pydantic.dev/mcp"
        },
        "mcp-playwright": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@playwright/mcp@latest"]
        },
        "runpod": {
            "type": "http",
            "url": "https://mcp.runpod.io/"
        }
    }
}
