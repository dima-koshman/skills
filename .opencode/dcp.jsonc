{
    "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
    "enabled": true,
    "autoUpdate": false,
    "debug": false,
    "pruneNotification": "minimal",
    "pruneNotificationType": "chat",
    "manualMode": {
        "enabled": false,
        "automaticStrategies": true
    },
    "compress": {
        "mode": "range",
        "permission": "allow",
        "showCompression": false,
        "summaryBuffer": true,
        "minContextLimit": "30%",
        "maxContextLimit": "70%",
        "nudgeFrequency": 5,
        "iterationNudgeThreshold": 15,
        "nudgeForce": "soft",
        "protectedTools": [],
        "protectTags": false,
        "protectUserMessages": false
    },
    "strategies": {
        "deduplication": {
            "enabled": true,
            "protectedTools": []
        },
        "purgeErrors": {
            "enabled": true,
            "turns": 4,
            "protectedTools": []
        }
    },
    "protectedFilePatterns": [".claude/memory/**"]
}
