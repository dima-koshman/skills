{
    // https://opencode.ai/v2/docs/config/ — written with opencode v2's native keys. v2 also
    // accepts the v1 names (agent, plugin, provider, snapshot, small_model) and normalizes
    // them in memory; `opencode debug config` prints what each file resolves to.
    //
    // No "$schema": as of v2.0.20, https://opencode.ai/config.json is still the v1 schema and
    // flags every v2 key above as invalid; no v2 config schema has been published yet.
    "model": "openai/gpt-5.6-sol",
    // NOT redundant with "model" above: an agent's own model ALWAYS wins over the top-level
    // key, and the GLOBAL config (~/.config/opencode/opencode.jsonc) ships an active
    // "agents" block pinning build -> openai/gpt-5.6-sol. Global agent entries survive into
    // this project because the two configs merge per-key rather than the project replacing
    // the global wholesale — so without an override here, "model" above is simply never
    // consulted for build and sessions silently open on gpt-5.6-sol.
    // Check with: opencode debug agents   (prints each agent's resolved providerID/model id)
    //
    // Models are "provider/model#variant".
    "agents": {
        "plan": { "model": "openai/gpt-5.6-sol#high" },
        "build": { "model": "openai/gpt-5.6-sol#medium" },
        // For Gemini on the Google (Antigravity) subscription, delegate to the agy CLI via
        // the cli-subagents skill; no Antigravity auth plugin runs on opencode v2.
        "general": { "model": "openai/gpt-5.6-luna#medium" },
        // Lightweight meta tasks such as session titles (v1's top-level "small_model").
        "title": { "model": "opencode/nemotron-3-ultra-free" }
        // explore searches and explains your local codebase
        // "explore": { "model": "opencode-go/deepseek-v4-flash#max" },
        // scout researches external dependencies and upstream documentation
        // "scout": { "model": "opencode-go/deepseek-v4-flash#high" },
        // Custom reviewer agent
        // "reviewer": {
        //     "description": "Reviews substantial completed work for correctness and specification compliance. Each call costs meaningful time and tokens, so reserve it for changes worth reviewing. Use your judgement.",
        //     "mode": "subagent",
        //     // "model": "opencode-go/glm-5.2#high",
        //     "model": "opencode-go/grok-4.5#high",
        //     "system": "You are a read-only code reviewer. First verify the completed work against the supplied specification or requirements, then review correctness, regressions, security, migrations, API usage, and test coverage. Report findings first, ordered by severity, with exact file and line references. Distinguish introduced defects from pre-existing issues. Do not modify files. Do not claim checks passed unless you ran them or received explicit evidence. If there are no findings, state that and list residual risks or testing gaps.",
        //     "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
        // }
    },
    "default_agent": "build",
    // Filesystem snapshots back undo/revert.
    "snapshots": false,
    // Auto-format after every write/edit with the available built-in formatters (ruff,
    // prettier, shfmt, ...). Formatting only — it never runs a lint --fix pass, so a repo whose
    // own task chains `ruff format` + `ruff check --fix` still needs that task run separately.
    "formatter": true,
    // opencode auto-discovers local plugins in .opencode/plugins/.
    // load-mcp-json.js is our custom bridge that imports non-secret MCPs from .mcp.json;
    // opencode does not natively read .mcp.json.
    //
    // opencode v2 runs only v2-API plugins; a v1 plugin shows up as "failed". Check with:
    //   opencode api GET /api/plugin -H "x-opencode-directory:$PWD" \
    //     | jq -c '.data[] | select(.source.type != "builtin") | {id, source, state}'
    "plugins": [
        // https://github.com/obra/superpowers
        // "superpowers@git+https://github.com/obra/superpowers.git",
        // https://github.com/mohak34/opencode-notifier
        // Ships v1 and v2 entrypoints in one package; v2 support since 0.7.0.
        "@mohak34/opencode-notifier@latest"
    ],
    // CAUTION: relative paths resolve against the directory holding THIS config file, not the
    // project root. From .opencode/, "path": "../.claude/memory" resolves to <project>/.claude/memory.
    "references": {
        "claude-memory": {
            "path": "../.claude/memory",
            "description": "Use for prior session notes and local project memory from Claude Code."
        }
    },
    // Auto-compaction summarizes the session into a checkpoint and carries on when the
    // context fills up. v2's tuning knobs are `keep.tokens` and `buffer`; left at defaults.
    "compaction": {
        "auto": true
    },
    "experimental": {
        // Maximum subagent nesting depth (v1 had it top-level as "subagent_depth").
        // 1 is the default; it stops subagents from launching subagents.
        "subagent_depth": 1
    },
    // Owned by `openwiki integrations install opencode` (task 'OpenWiki: install agent
    // integrations'). Kept here verbatim so 'Sync: OpenCode config globally' carries the entry
    // instead of deleting it. The installer accepts only this exact shape — any added key makes
    // it report the entry as modified and refuse to reinstall.
    "mcp": {
        "openwiki": {
            "type": "local",
            "command": ["openwiki", "mcp", "--host", "opencode"],
            "enabled": true
        }
    }
}
