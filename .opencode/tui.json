{
    // https://opencode.ai/docs/tui
    "$schema": "https://opencode.ai/tui.json",
    // To send text selection to opencode via sst-dev.opencode vscode plugin, use:
    // cmd + opt + k
    "keybinds": {
        "messages_next": "ctrl+l",
        "messages_previous": "ctrl+o",
        "history_previous": "none",
        "history_next": "none"
    },
    // https://opencode.ai/docs/tui/#attention
    "attention": {
        "enabled": true,
        "notifications": true,
        "sound": false,
        "volume": 0.4,
        "sounds": {
            "subagent_done": "silence.wav"
        }
    }
}
