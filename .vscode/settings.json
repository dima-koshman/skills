{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "files.watcherExclude": {
        "**/.venv/**": true
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.ipynb_checkpoints": true,
        "**/*.egg-info": true,
        ".venv/bin": true,
        ".venv/.lock": true,
        ".venv/CACHEDIR.TAG": true,
        ".venv/share": true,
        ".venv/include/": true,
        ".venv/etc": true,
        ".venv/pyvenv.cfg": true,
        ".venv/.gitignore": true,
        ".venv/requirements.txt": true,
        ".venv/tests-requirements.txt": true,
        ".venv/**/*.dist-info": true,
        ".venv/**/*.pth": true,
        ".venv/**/*.so": true
    },
    "search.exclude": {
        "**/.venv": true
    },
    "python.analysis.exclude": ["**/.venv/**", "**/__pycache__/**"],
    "basedpyright.analysis.exclude": ["**/.venv/**", "**/__pycache__/**"]
}
