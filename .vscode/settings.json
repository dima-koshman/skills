{
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[mojo]": {
        "editor.defaultFormatter": "modular-mojotools.vscode-mojo"
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[shellscript]": {
        "editor.defaultFormatter": "mkhl.shfmt"
    },
    "[skill]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "breadcrumbs.enabled": true,
    "chat.disableAIFeatures": false,
    "claudeCode.hideOnboarding": true,
    "claudeCode.preferredLocation": "panel",
    "editor.codeActionsOnSave": {
        "source.organizeImports.ruff": "always"
    },
    "editor.formatOnSave": true,
    "editor.minimap.enabled": false,
    "evenBetterToml.formatter.alignComments": true,
    "evenBetterToml.formatter.alignEntries": true,
    "evenBetterToml.formatter.arrayAutoCollapse": false,
    "evenBetterToml.formatter.indentEntries": true,
    "evenBetterToml.formatter.indentTables": true,
    "evenBetterToml.formatter.reorderArrays": true,
    "evenBetterToml.formatter.reorderInlineTables": true,
    "evenBetterToml.formatter.reorderKeys": true,
    "evenBetterToml.formatter.trailingNewline": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "afterDelay",
    "files.exclude": {
        ".venv/.gitignore": true,
        ".venv/.lock": true,
        ".venv/**/*.dist-info": true,
        ".venv/**/*.pth": true,
        ".venv/**/*.so": true,
        ".venv/bin": true,
        ".venv/CACHEDIR.TAG": true,
        ".venv/etc": true,
        ".venv/include/": true,
        ".venv/**/*.pyx": true,
        ".venv/**/py.typed": true,
        ".venv/pyvenv.cfg": true,
        ".venv/requirements.txt": true,
        ".venv/share": true,
        ".venv/tests-requirements.txt": true,
        "**/__pycache__": true,
        "**/.ipynb_checkpoints": true,
        "**/*.egg-info": true,
        ".pytest_cache": true,
        ".ruff_cache": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/.worktrees/**": true
    },
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.detectWorktrees": false,
    "indentRainbow.indicatorStyle": "light",
    "indentRainbow.lightIndicatorStyleLineWidth": 4,
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://models.dev": true,
        "https://opencode.ai": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "jupyter.askForKernelRestart": false,
    "notebook.cellToolbarLocation": {
        "default": "hidden"
    },
    "notebook.formatOnSave.enabled": true,
    "notebook.globalToolbar": false,
    "notebook.showCellStatusBar": "visibleAfterExecute",
    "prettier.tabWidth": 4,
    "prettier.trailingComma": "none",
    // Pylance low-memory mode, against one 0.5-2.5 GB Pylance per window. It changes these defaults:
    // - indexing: false - no index of installed packages and workspace files, so no auto-import
    //   completions or add-import fixes for names not imported yet, and only open files in
    //   workspace symbol search (Cmd+T).
    // - useLibraryCodeForTypes: false - libraries without stubs or py.typed are no longer read
    //   for types, so their objects show as Unknown in hovers and completions.
    // - enablePytestSupport: false - no fixture types, completions or go-to-definition in tests.
    // - exclude: ["**"] - overridden by python.analysis.exclude below, which is set explicitly.
    // Any of these set explicitly here wins over the mode; "default" restores the normal mode.
    "python.analysis.languageServerMode": "light",
    "python.analysis.exclude": [
        "**/.venv/**",
        "**/__pycache__/**",
        "**/.*",
        "**/node_modules"
    ],
    "basedpyright.analysis.exclude": [
        "**/.venv/**",
        "**/__pycache__/**",
        "**/.*",
        "**/node_modules"
    ],
    "ruff.lineLength": 100,
    "search.exclude": {
        "**/.venv": true,
        "**/.worktrees": true
    },
    "sql-formatter.uppercase": true,
    "task.problemMatchers.neverPrompt": {
        "python": true,
        "shell": true
    },
    "window.title": "${rootName}",
    "window.autoDetectColorScheme": true,
    "window.newWindowDimensions": "fullscreen",
    "workbench.colorTheme": "Light Modern",
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "editor.accessibilitySupport": "off",
    "task.autoDetect": "off",
    "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.terminal.selectAll"
    ],
    "workbench.editorAssociations": {
        "*.md": "default",
        "*.markdown": "default"
    },
    "workbench.startupEditor": "none",
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "indentRainbow.ignoreErrorLanguages": ["markdown", "python"],
    "shfmt.executablePath": "/opt/homebrew/bin/shfmt",
    "pixi-code.pixiExecutable": "/Users/koshmandmitry/.pixi/bin/pixi"
}
