{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.6-sol",
    "agent": {
        "plan": { "model": "openai/gpt-5.6-sol", "variant": "high" },
        "build": { "model": "openai/gpt-5.6-sol", "variant": "medium" },
        // "general": { "model": "openai/gpt-5.6-luna", "variant": "medium" },
        "general": {
            "model": "google/antigravity-gemini-3.6-flash-tiered",
            "variant": "high"
        },
        // explore searches and explains your local codebase
        "explore": {
            "model": "opencode-go/deepseek-v4-flash",
            "variant": "max"
        },
        // scout researches external dependencies and upstream documentation
        "scout": {
            "model": "opencode-go/deepseek-v4-flash",
            "variant": "high"
        }
    }
}
