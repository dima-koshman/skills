  "claims": [
    {
      "id": "claim_8c393fdbfcaf4c0480e91666cf83cd17",
      "statement": "The source notes define an agent as an LLM-driven loop that selects actions, uses tools, observes results, and repeats; planning, memory, and optional subagent delegation are recurring ingredients, while a harness drives the loop and a fixed workflow is preferable when control flow can be predetermined.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/agents/agent.md#L7-L17",
          "version": "repo-lines-v1:sha256:265dce9cc29a401e3c736da13d8d1cdf3fb76bc15b1653c7212b098cb69d0a8d:"
        }
      ]
    },
    {
      "id": "claim_f56567a6a04e47adbcd8803aa959ebc9",
      "statement": "A subagent is a task-scoped delegate whose parent assigns part of a goal and usually controls the task and the subagent lifecycle; peer and subagent implementations may share endpoint, tool, or asynchronous-job machinery without sharing the same authority model.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/agents/peer-agents.md#L22-L28",
          "version": "repo-lines-v1:sha256:1dd05dc1a3e01058a5b4dc89e0be36b60d10a52667c42a974018471ddf42a095:"
        },
        {
