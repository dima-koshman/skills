          "version": "repo-lines-v1:sha256:2ef88cff49192ed282535780c6aa2b0750ca8d6b3aea2c72869a08985aacc7ec:"
        }
      ]
    },
    {
      "id": "claim_859e0968639d41aaa6876035530eba1d",
      "statement": "Peerhood is defined by independent goal and authority ownership rather than transport: either peer may initiate collaboration, neither generally overrides or terminates the other, and a relationship can be task-scoped even when the agents remain system-level peers.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/agents/peer-agents.md#L30-L33",
          "version": "repo-lines-v1:sha256:5eeb9c5d640480171edae0313c5d42e347999464f0b52e18c306d934068b66fa:"
