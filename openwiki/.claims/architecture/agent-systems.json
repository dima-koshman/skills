  "claims": [
    {
      "id": "claim_e0d4a9bbfd72470ba0c17f0530204eb0",
      "statement": "An agent is generally an LLM in a loop with tools: the model selects an action, invokes a tool, observes the result, and repeats; model-directed control flow distinguishes this architecture from a fixed workflow.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/agents/agent.md#L7-L15",
          "version": "repo-lines-v1:sha256:9a13fc5d4a598e474c0ea4b680548379eb418d7b7501b351bc6820a1aa7f6639:"
        }
      ]
    },
    {
      "id": "claim_392392731740478ba2cff205713eed1e",
      "statement": "The harness is the concrete runtime around the model loop: it parses model responses, dispatches tool calls, feeds results back, manages context and memory, enforces retries, step limits, budgets, and sandboxing, and decides when to stop.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/harness/harness.md#L3-L5",
          "version": "repo-lines-v1:sha256:5df187e5d0bfe122df29dcc0b7f81e9db8ef5a0f621dfbba015cffa9b7011749:"
        }
      ]
    },
    {
      "id": "claim_3038e3eb207b49e59cab356c1ef9518c",
      "statement": "Tools let an agent act on its environment and fetch new context, and can be used for direct operations, workflow orchestration, or recursive subagent calling.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/harness/tools.md#L7-L15",
          "version": "repo-lines-v1:sha256:f29cfd0190c65b6c9059084e1812c0f1ddd1adfcc56fe1b735a4848783b360bb:"
        }
      ]
    },
    {
      "id": "claim_886e2074881f4a7a82a5f658c07ef187",
      "statement": "Tools have distinct execution boundaries: client-side backend tools, client-side frontend tools, and provider-side tools that are defined and executed by the model provider.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/harness/tools.md#L17-L28",
          "version": "repo-lines-v1:sha256:de0120095bed51fc7ef12ebbe034f044137d370ea3d1b5648e285a584557f8a8:"
        }
      ]
    },
    {
      "id": "claim_7487824508d64186a37bf5ef18fed1a5",
