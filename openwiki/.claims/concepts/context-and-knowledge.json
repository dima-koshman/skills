    {
      "id": "claim_549eeee59466482b9de7b291331999ee",
      "statement": "OpenWiki uses deterministic local raw snapshots and manifests as inputs to source-specific synthesis, produces agent-oriented Markdown, retains raw artifacts for provenance checks, and can refresh the derived wiki through scheduled ingestion without putting the full source corpus into every context.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/context/openwiki.md#L7-L18",
          "version": "repo-lines-v1:sha256:53b19fe9648e4b0a8943b26dbe9e4174ae7b2e262dd6520033572d919da26353:"
