    },
    {
      "id": "claim_ecf9aaab09eb45c0b3890d1bf4c5101c",
      "statement": "Pre-synthesized wiki knowledge and query-time RAG have different freshness boundaries: OpenWiki organizes source material before a task, while RAG fetches relevant material at query time; a hybrid can use the wiki for orientation and live retrieval or tools for verification.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/context/openwiki.md#L22-L31",
          "version": "repo-lines-v1:sha256:48328cf5db581f90b194abba94ae08f8f817d0b7286615ea0f123d1873c8e0af:"
