    {
      "id": "claim_9bc0c1adb35b408ba2c06df18aa871a7",
      "statement": "MCP is a JSON-RPC boundary that exposes tools, resources, and prompts between an LLM client and external capabilities; its stateful initialization handshake and persistent connection support capability negotiation and server notifications, while session state complicates remote horizontal scaling.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/context/mcp.md#L7-L27",
          "version": "repo-lines-v1:sha256:0c17aa00406eb56038706437654f30a80d9f8c2504eb3759255f35a6871cc1ee:"
        }
