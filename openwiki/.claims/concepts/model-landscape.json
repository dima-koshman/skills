  "claims": [
    {
      "id": "claim_99eb5e127f8f42d89a5aac920cc7a9c0",
      "statement": "Modern open-weight LLMs generally retain a decoder-only Transformer core, while model-family differences relevant to engineering are commonly efficiency and multimodality choices layered onto that core.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/models/llm-architecture.md#L12-L16",
          "version": "repo-lines-v1:sha256:88315e899fef93467e27413551832ba86bdb3f036ac7a6cba08ef3ec35fc2157:"
        }
      ]
    },
    {
      "id": "claim_93950f65dc454f21b6c57e6d1414d17d",
      "statement": "MoE models route each token to only some experts, so total parameters primarily indicate weight-memory and capacity scale while active parameters more directly indicate per-token compute and latency; headline parameter counts are therefore not directly comparable between MoE and dense models.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/models/llm-architecture.md#L18-L29",
          "version": "repo-lines-v1:sha256:f29e40303ea4d0fa6f8616b9c064ccb8ed0c5ca70fd0920215b7d57f12e1f2a5:"
        }
      ]
    },
    {
      "id": "claim_38445630bab54a8eb600af0501f50cbb",
      "statement": "Autoregressive KV caching avoids recomputing the prefix but consumes memory that grows with context length, layers, and attention heads; MHA, GQA, and MLA reduce or reshape this cache in different ways, and serving stacks may additionally reuse shared prefixes.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/models/llm-architecture.md#L39-L66",
          "version": "repo-lines-v1:sha256:fc97eff092e09769ccf4b763318f3e62c709042fe1005dd45e71d163cd531c9f:"
        }
      ]
    },
    {
      "id": "claim_e74fb9e957e4435e9c20edaa542029af",
      "statement": "Sliding-window and linear or hybrid attention reduce cache and compute but require sufficient global-attention access for reliable long-range behavior, so a long context limit alone does not establish long-context quality.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/models/llm-architecture.md#L68-L83",
          "version": "repo-lines-v1:sha256:5a702b0b3d8b958d0a0c9f0dd14a128fecbf18826b2f469b1b9fc532e8f63a07:"
        }
      ]
    },
    {
      "id": "claim_fb38536d64144d0a8819dec35859d28b",
      "statement": "Unified embedding-decoder multimodality projects modality representations into the text embedding stream, whereas cross-modality attention keeps text in the decoder stream and reads encoder outputs through cross-attention; the approaches trade tooling simplicity and image-token context use against cross-modal complexity and text-only preservation.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/models/llm-architecture.md#L111-L133",
          "version": "repo-lines-v1:sha256:f37471844b3074624fe2048e11c51f7f07777aef90851c70fa03f5938979c493:"
        }
      ]
    },
    {
      "id": "claim_3ae59586adb44541b589372c217996ed",
      "statement": "Jev is documented as a typed System One decision primitive with Choice, Score, and Noul results; questions are evaluated independently against the same state, and typed output does not itself establish correctness or calibration.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/models/jev.md#L9-L35",
          "version": "repo-lines-v1:sha256:d5ec30e5b39eec5c800bacf871a3175840321f842eb06088e6829b4d4477c6e0:"
        }
      ]
    },
    {
      "id": "claim_ef0c6c246f014b5ba0f50265a305432d",
      "statement": "CLM is a separately trained open-source decision-model alternative that scores supplied candidates using separately computed state and action representations rather than generating an arbitrary new action; its documented CLM-v0.1-8B serving path uses a frozen Qwen3-8B backbone and has a default 2,048-token encoder context.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/models/clm.md#L17-L23",
