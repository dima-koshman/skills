  "claims": [
    {
      "id": "claim_97b04c6aaa8b45cf81d0f6a939617a62",
      "statement": "Architectural selection should begin by identifying cohesion, independent-change, runtime, consistency, contract, and failure-containment boundaries; a module boundary inside one process has different costs from a service boundary that adds network and deployment concerns.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/architecture/architectural-patterns.md#L19-L31",
          "version": "repo-lines-v1:sha256:3fea233a8d927c5489cbb5ae002f661854ee13e6bf1d19107c563ec8812564e0:"
        },
        {
          "resource": "repo://wiki/software-engineering/architecture/architectural-patterns.md#L91-L95",
          "version": "repo-lines-v1:sha256:2a03677f6ead886870af16f8973dad19a9130cca1225607224f94e141576b6a0:"
        }
      ]
    },
    {
      "id": "claim_0c174b174e594c948c1518304143634c",
      "statement": "The pattern toolkit is situational rather than prescriptive: modular monoliths, layers, services, ports and adapters, pipelines, gateways, orchestrators, and plugins each solve different forces and introduce distinct contract, failure, ownership, or operational questions.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/architecture/architectural-patterns.md#L33-L46",
          "version": "repo-lines-v1:sha256:e9b43fc49f08f071ec14e603581ed0ad909a6a89b74fc8576156ca88e2262b41:"
        }
      ]
    },
    {
      "id": "claim_eb9bbcb6fb834d5bb44efae43f1dd3b4",
      "statement": "Orchestration, choreography, and shared-data integration place coupling in different locations: workflow ownership, event reactions, or shared schemas; these styles can coexist, but designs must make write ownership, atomicity, stale-read tolerance, and duplicate-side-effect handling explicit.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/architecture/architectural-patterns.md#L58-L75",
          "version": "repo-lines-v1:sha256:c5fb8d10dcf2aac178692bf2d0024227324808022ae0e3ca6a4962a08a3668e3:"
        }
      ]
    },
    {
      "id": "claim_8d9afcda55ac4ca1bef111c2455f169a",
      "statement": "A service or other distributed boundary requires explicit handling of remote failure, data ownership, compatibility, consistency, latency, and operations rather than assuming that independent deployment is a free benefit.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/architecture/architectural-patterns.md#L19-L24",
