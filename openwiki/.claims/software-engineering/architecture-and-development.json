        {
          "resource": "repo://wiki/software-engineering/reliability/simplicity.md#L9-L31",
          "version": "repo-lines-v1:sha256:837bc91bf39ab9a91a7e73ee007bf3d7875673d13f36affa76b2777ab635916a:"
        }
