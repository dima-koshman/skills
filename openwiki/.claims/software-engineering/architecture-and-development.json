        }
      ]
    },
    {
      "id": "claim_a09efa033a854e16bef7babb782ecd6b",
      "statement": "Protocol Buffers illustrates that schema evolution is part of a service contract: permanent field numbers enable old and new producers and consumers to interoperate, while non-self-describing payloads make schema distribution a required operational concern.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/communication/protobuf.md#L15-L30",
