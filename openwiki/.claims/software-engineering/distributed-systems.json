    {
      "id": "claim_bba6f46a936040d6acc70023a88e4e88",
      "statement": "Protocol Buffers define language-neutral structured messages in .proto files and protoc generates native accessors, serializers, parsers, and bindings at build time; application code uses the generated artifacts.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/communication/protobuf.md#L7-L13",
          "version": "repo-lines-v1:sha256:75b89054d585e3bd26bd4a37fc9ac510a203da74f76ef386ab71468cc93930a0:"
        }
      ]
    },
    {
      "id": "claim_86f2eb23c90849e78bc682de359b03d4",
      "statement": "Protobuf field numbers are wire identifiers that must not be reused, enabling older readers to ignore unknown fields and newer readers to default absent fields so producers and consumers can be deployed independently.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/communication/protobuf.md#L15-L22",
          "version": "repo-lines-v1:sha256:30ec646b7862c285c29454bd0b3b5eed3521f412b42e7a31f46b0adaa9bf47ad:"
        }
      ]
    },
    {
      "id": "claim_3debcbe8c6434888a3b1043f27606d0a",
      "statement": "Protobuf payloads are not self-describing and the same logical message can have multiple valid binary encodings, so schema distribution is required and serialized bytes must not be used as message equality, hash, or signature surrogates.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/communication/protobuf.md#L24-L30",
          "version": "repo-lines-v1:sha256:50ed9edb2c659ea817995c974e975fa5ddace53342fb815c468f8ff09d0c89a0:"
