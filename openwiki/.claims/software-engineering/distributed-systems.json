    },
    {
      "id": "claim_4031ff868d434f288f76740368c0c747",
      "statement": "gRPC supports unary, server-streaming, client-streaming, and bidirectional-streaming calls over HTTP/2, and provides first-class deadlines, cancellation, metadata, channels, and fixed status codes.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/communication/grpc.md#L17-L36",
          "version": "repo-lines-v1:sha256:4b4ec712d94d25a8ae98b2c75081934d3d9b04cdd7bd5cec807e7d7684c3770c:"
        }
