        {
          "resource": "repo://wiki/software-engineering/communication/grpc.md#L47-L51",
          "version": "repo-lines-v1:sha256:4b2a7017ad2605f8c339be162c825495280f045ed47bac20eba52a806c17a076:"
        }
      ]
    },
    {
      "id": "claim_dd7582a0ba664a2c8ce387e1c8685911",
      "statement": "The data plane carries application traffic and applies received rules, the control plane decides and distributes policy, and the management plane provides operator configuration, inspection, administration, and monitoring surfaces.",
      "evidence": [
