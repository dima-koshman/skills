        }
      ]
    },
    {
      "id": "claim_3150f1f594524173ace9782eb07d15ad",
      "statement": "gRPC uses Protocol Buffers as an interface definition language: one definition declares messages and services and code generation produces typed client stubs and server skeletons.",
