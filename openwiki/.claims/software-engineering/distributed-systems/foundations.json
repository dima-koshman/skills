    {
      "id": "claim_c2193a3ddef441c4a9d39bb44de9f92b",
      "statement": "GFS uses a master for metadata and chunkservers for replicated chunks; clients obtain locations from the master and transfer data directly to chunkservers, while large chunks and append-heavy workloads shape its assumptions.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/distributed-systems/google_file_system.md#L8-L15",
          "version": "repo-lines-v1:sha256:08980f51915dc093cd7026243588f65358dcca6df38caa7d8239393273ec913b:"
        }
      ]
    },
    {
      "id": "claim_7c6a069165024d89a2378e7eedc060ea",
      "statement": "GFS leases coordinate mutation order, but record append can produce duplicates, leaving applications responsible for handling them rather than receiving general-purpose POSIX-style consistency in every case.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/distributed-systems/google_file_system.md#L10-L15",
          "version": "repo-lines-v1:sha256:64c7da999789797d9cce793777db4632a9e681be004fec760ba9089f8050b7c7:"
        }
      ]
    },
    {
      "id": "claim_6edcde997faa42b18b43807d72c82ca8",
      "statement": "Bigtable is a sparse sorted map indexed by row, column, and timestamp; tablets partition row ranges, row operations are atomic, and row-key choices determine locality and range-scan behavior.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/distributed-systems/bigtable.md#L8-L15",
          "version": "repo-lines-v1:sha256:da84a19b996fd9260e55dcd187ae66b249714193c21c13a3701e53d1a789f45b:"
        }
      ]
    },
    {
      "id": "claim_998fb068ad7d400abd623a6910a05f60",
      "statement": "Bigtable combines GFS for persistent storage and Chubby for coordination with memtables, SSTables, and compaction, making data layout and storage-engine behavior part of the design.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/distributed-systems/bigtable.md#L10-L15",
          "version": "repo-lines-v1:sha256:9696a5807ef9c36f8ba5a9ce6071d9efbc7d9107c1fb1d21e4776f10ef372221:"
        }
      ]
    },
    {
      "id": "claim_2f917b8507f04f61a267a19905ef4dbb",
      "statement": "MapReduce's programming model emits intermediate key/value pairs from map, groups them by key during shuffle, and processes groups in reduce; the runtime owns partitioning, scheduling, communication, locality, and worker-failure recovery.",
