        {
          "resource": "repo://wiki/software-engineering/distributed-systems/map_reduce.md#L8-L15",
          "version": "repo-lines-v1:sha256:e0c9c51ab918484348b35778ae9b57dba216af9704615f4e3aff6ed24c12b440:"
        }
      ]
    },
    {
      "id": "claim_58c72a6199564b1c96131841b730b0b8",
      "statement": "MapReduce backup tasks address slow workers, and task re-execution makes determinism and side-effect handling part of the processing contract.",
