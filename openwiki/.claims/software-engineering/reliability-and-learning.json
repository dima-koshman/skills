    {
      "id": "claim_ea62d964331147a181fd71209ba746a0",
      "statement": "Google's SRE guidance caps toil below about 50% of each engineer's time averaged over quarters, reserving the remainder for engineering that reduces future toil or adds features; averages can hide individuals carrying much higher loads, and manually triggering a script remains toil.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/reliability/toil.md#L31-L54",
          "version": "repo-lines-v1:sha256:c449457e3c525a5546ab87bf292645b3210613cee388ee4013799ccab78eda33:"
