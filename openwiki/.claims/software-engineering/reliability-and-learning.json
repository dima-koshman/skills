    {
      "id": "claim_73a767d2408a4450ac4d78f6a631635f",
      "statement": "Toil is operational work that is manual, repetitive, automatable or removable through better design, tactical and interrupt-driven, lacking enduring value, and approximately O(n) with service size, traffic, or users; overhead and one-off grungy work that leaves lasting value are distinct categories.",
      "evidence": [
        {
          "resource": "repo://wiki/software-engineering/reliability/toil.md#L13-L29",
          "version": "repo-lines-v1:sha256:1f7c5fc8617f5ad4c620c6353d982e80feefe8340cacd6ea0cbef36991881296:"
