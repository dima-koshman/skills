  "claims": [
    {
      "id": "claim_a3deef66b40547928b5c12f5448badf4",
      "statement": "The AI-native software lifecycle is a loop of Plan, Design, Build, Test, Deploy, and Maintain stages in which committed artifacts trigger subsequent gates and provide an audit trail.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L40-L56",
          "version": "repo-lines-v1:sha256:06e83f7939be23880731cd9cb9e07622ad4c9f9b4fa6c0fd7921d15e4e7d4195:"
        },
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L5-L12",
          "version": "repo-lines-v1:sha256:a515984a2f274ece307923adcbaf755b0d12fc1b5db00a10d87f6771de69a75e:"
        }
      ]
    },
    {
      "id": "claim_7004a6dbdc0a4a72970e1ffeac9b3380",
      "statement": "AI-native development shifts human work toward intent, risk, review, and approval gates: agents may draft, implement, review, and diagnose, but people accept intent, approve specifications and plans, approve pull requests, and authorize releases.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L139-L166",
          "version": "repo-lines-v1:sha256:8c4c384adb57dcaedf2d2785b3cd40138b6c71dafcaa9984d22a22bcbd74ef62:"
        },
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L198-L215",
          "version": "repo-lines-v1:sha256:cbffec2f0913be725b69fa677de48f2e62852395c7f6edabb1eb13de41984e85:"
        }
      ]
    },
    {
      "id": "claim_a95644546c2a4dce9395181c81e00d4f",
      "statement": "Implementation is safer when the agent plans before editing, records the plan, uses project instructions and advisory skills for institutional knowledge, and relies on deterministic hooks and CI for invariants that must always hold.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L94-L119",
          "version": "repo-lines-v1:sha256:008be5cdb8f7abd495e7317ce1fb54afd38b5425fe15ca39bbcdbe5b8f92f808:"
        }
      ]
    },
    {
      "id": "claim_5a200b25d6854e098f4954451f1c26e6",
      "statement": "The development feedback loop should use single-command verification, regression tests that can be established before a fix, and continuous evaluations of model prompts, instructions, skills, hooks, and other agent configuration; production incidents should become evaluation cases.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L121-L137",
          "version": "repo-lines-v1:sha256:6c4905acb264c932d17b816225d1ca7f0fa4c3320baa47adba19407dd445aca8:"
        }
      ]
    },
    {
      "id": "claim_da07b021af574d28a4d8941de2650a05",
      "statement": "Review and deployment require separation of duties and explicit gates: agent findings do not approve pull requests, branch protection requires human ownership, and write-capable pipeline automation should produce reviewable changes while production credentials remain scoped and short-lived.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L139-L163",
          "version": "repo-lines-v1:sha256:6b625f0ced2d48768fccb0637c99a91e972e81232e017ae19880168807c6a5f7:"
        },
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L200-L211",
          "version": "repo-lines-v1:sha256:7c97463bf36e5aa922217b6a97a0aef5f3d78a17b69fef029fdff76a3339cc28:"
        }
      ]
    },
    {
      "id": "claim_93deb3bfee124827aab3cd286b8a4957",
      "statement": "Observability-driven development connects runtime telemetry to bounded diagnosis and change: instrument behavior, retrieve bounded evidence, correlate it with code and deployments, make the smallest supported change, verify with tests and telemetry, and retain the resulting learning.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/observability-driven-development.md#L5-L35",
          "version": "repo-lines-v1:sha256:f86aaccf7deaf00729301ad6cbc583351bebdf199888a2de4b04ce9356af4c34:"
        },
        {
          "resource": "repo://wiki/ai-engineering/development/observability-driven-development.md#L75-L89",
          "version": "repo-lines-v1:sha256:df5981df4adafdcc868eecf24cbdb96d52b28a899035fa0f5b4fa0295777af58:"
        }
      ]
    },
    {
      "id": "claim_969a04fcaca64c00bc91127f90e74df3",
      "statement": "AI-layer traces and application telemetry are complementary evidence sources, and correlation should prefer shared trace or request identifiers because timestamp- or text-based linkage without them is only probabilistic.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/observability-driven-development.md#L51-L73",
          "version": "repo-lines-v1:sha256:f3a49bca43aeb87e76715a6b3317653d58b7b6adfac6ba6839c89abc4e7994e9:"
        }
      ]
    },
    {
      "id": "claim_53b966b33c864540b710ccd42024b883",
      "statement": "Telemetry and model output are incomplete or untrusted evidence: missing spans do not prove health, findings should be bounded and deduplicated, sensitive data should be minimized, and suggested actions require independent verification and separate production permissions.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/observability-driven-development.md#L91-L111",
          "version": "repo-lines-v1:sha256:b6150a080b2850bd0f0fa4a807a0b8253eababd15ff5a259facf9c2a02a7d5ae:"
        }
      ]
    },
    {
      "id": "claim_9dff2f6954db43e78f926059614185c8",
      "statement": "Maintenance closes the lifecycle by converting control-band breaches, security findings, and incidents into triaged intent, reviewable fixes or runbooks, and permanent evaluations, with deterministic monitoring and independent confidence gates controlling escalation.",
      "evidence": [
        {
          "resource": "repo://wiki/ai-engineering/development/ai-native-sdlc.md#L168-L196",
